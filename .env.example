# Set JWT_SECRET in your environment before starting the backend.
# Use a unique random value of at least 32 characters. Do not commit the real value.
JWT_SECRET=
DB_PASSWORD=

# Optional SMTP settings for password reset emails.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
RESET_TOKEN_EXPIRY_MINUTES=15

# Set this in your local .env before starting the database with Docker Compose.
DB_PASSWORD=
